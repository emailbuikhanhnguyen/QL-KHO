# Supabase Postgres — pooler (PgBouncer, port 6543) dung cho app chay hang ngay
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Postgres — direct connection (port 5432) chi dung cho `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

PORT=3000

# Auth / JWT
# QUAN TRONG: doi JWT_SECRET thanh chuoi ngau nhien dai khi deploy that,
# khong dung gia tri mac dinh trong code.
JWT_SECRET="doi-chuoi-nay-thanh-random-dai-va-bi-mat"
JWT_EXPIRES_IN="8h"

# Tai khoan admin mac dinh duoc tao boi `npm run prisma:seed`
SEED_ADMIN_EMAIL="admin@congty.com"
SEED_ADMIN_PASSWORD="Admin@123456"
